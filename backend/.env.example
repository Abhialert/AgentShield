# AgentShield Environment Configuration
# Copy this file to .env and fill in real values before running

# REQUIRED: Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AGENTSHIELD_SECRET=your-32-byte-hex-secret-here

# Set to "production" to enforce secret requirement (server refuses to start without valid secret)
AGENTSHIELD_ENV=development

# Token expiry in hours (default: 24)
TOKEN_EXPIRE_HOURS=24
